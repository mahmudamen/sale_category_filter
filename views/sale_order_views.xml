<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inherit Form View -->
    <record id="view_order_form_inherit_category" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.category</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <!-- Add custom report button in header -->
            <xpath expr="//header" position="inside">
                <button name="action_open_report_wizard" type="object"
                        string="Generate Custom Report" class="btn-secondary"
                        invisible="state == 'cancel'"/>
            </xpath>
            <!-- Add category field and other custom fields after the customer field -->
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="categ_id" options="{'no_create': True}"/>
                <field name="project_name" placeholder="e.g., 10th Ramadan"/>
                <field name="service_type" placeholder="e.g., Gas Boiler"/>
            </xpath>

            <!-- Add domain filter to product_id in order lines list view -->
            <xpath expr="//field[@name='order_line']//list//field[@name='product_id']" position="attributes">
                <attribute name="domain">[
                    '|',
                        ('categ_id', '=', False),
                        '|',
                            ('categ_id', '=', parent.categ_id),
                            '&amp;',
                                ('categ_id', '!=', False),
                                ('categ_id', 'child_of', parent.categ_id),
                    ('sale_ok', '=', True)
                ]</attribute>
            </xpath>

            <!-- Add domain filter to product_template_id in order lines list view -->
            <xpath expr="//field[@name='order_line']//list//field[@name='product_template_id']" position="attributes">
                <attribute name="domain">[
                    '|',
                        ('categ_id', '=', False),
                        '|',
                            ('categ_id', '=', parent.categ_id),
                            '&amp;',
                                ('categ_id', '!=', False),
                                ('categ_id', 'child_of', parent.categ_id),
                    ('sale_ok', '=', True)
                ]</attribute>
            </xpath>
        </field>
    </record>


    <!-- Optional: Add category field to list view -->
    <record id="view_order_list_inherit_category" model="ir.ui.view">
        <field name="name">sale.order.list.inherit.category</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_list"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="categ_id" optional="show"/>
            </xpath>
        </field>
    </record>

    <!-- Optional: Add category field to search view -->
    <record id="view_sales_order_filter_inherit_category" model="ir.ui.view">
        <field name="name">sale.order.search.inherit.category</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_sales_order_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="categ_id"/>
            </xpath>
            <xpath expr="//group" position="inside">
                <filter string="Product Category" name="group_categ_id" context="{'group_by': 'categ_id'}"/>
            </xpath>
        </field>
    </record>
</odoo>
